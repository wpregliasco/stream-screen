#!/bin/sh

SCRIPT=$(readlink -f -- "$0" 2>/dev/null || realpath -- "$0" 2>/dev/null)
[ -z "$SCRIPT" ] && SCRIPT=$0
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
MEDIA_DIR="$BASE_DIR/mediamtx"
MEDIA_BIN="$MEDIA_DIR/mediamtx"
WWW_DIR="$BASE_DIR/www"

WEB_PORT="${WEB_PORT:-8090}"

usage() {
    echo "Usage: $0 {start|stop|help}"
    echo
    echo "  start  Launch MediaMTX and the classroom web page"
    echo "  stop   Stop MediaMTX and the web server"
    echo "  help   Show this message"
    echo
    echo "Environment variables:"
    echo "  WEB_PORT  HTTP port for the classroom page (default: 8080)"
}

start() {
    if pgrep -x mediamtx >/dev/null 2>&1; then
        echo "MediaMTX already running"
    else
        nohup sh -c "cd '$MEDIA_DIR' && exec '$MEDIA_BIN'" >/tmp/classroom-mediamtx.log 2>&1 &
        echo "MediaMTX started"
    fi

    if pgrep -f "http.server $WEB_PORT" >/dev/null 2>&1; then
        echo "Web server already running on port $WEB_PORT"
    else
        nohup python3 -m http.server "$WEB_PORT" --directory "$WWW_DIR" >/tmp/classroom-web.log 2>&1 &
        echo "Web server started on port $WEB_PORT"
    fi
}

stop() {
    pkill -f "http.server $WEB_PORT"
    pkill -x mediamtx
    echo "classroom server stopped"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 1
        ;;
esac
